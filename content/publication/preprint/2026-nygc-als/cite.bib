@article {humphrey2026nygcals,
	author = {Humphrey, Jack and Oku, Ali and Byrska-Bishop, Marta and Basile, Anna O. and Evani, Uday S. and Corvelo, Andr{\'e} and Tokolyi, Alex and BP, Kailash and R{\'e}al, Aline and Kim, Yebin and Bond, Marielle L. and Clarke, Wayne E. and Fu, Rui and Geiger, Heather and Chang, Sei and Naito, Tatsuhiko and Jang, Beomjin and Musunuri, Rajeeva and Dredge, Winston H and Al-Abri, Rashid and Hoover, Benjamin N and Manaa, Dina and McClintock, Jaime and Singh, Faith P and Pedersen, Maria H and Runnels, Alexi and Propp, Nadia and Fennessey, Samantha and Won, Hong-Hee and Zody, Michael C. and Narzisi, Giuseppe and Robine, Nicolas and Lappalainen, Tuuli and Fagegaltier, Delphine and G{\"u}rsoy, Gamze and Knowles, David A. and Raj, Towfique and NYGC ALS Consortium and Harms, Matthew B and Phatnani, Hemali},
	title = {The New York Genome Center ALS Consortium resource integrates postmortem tissue transcriptomics and whole genome sequencing to empower biological discovery},
	elocation-id = {2026.04.29.26350889},
